+    ## Android / Termux: query persist.sys.timezone via getprop
+    if (grepl("android", R.Version()$os, ignore.case = TRUE) &&
+        file.exists("/system/bin/getprop")) {
+        tz0 <- try(system("/system/bin/getprop persist.sys.timezone", intern = TRUE), silent = TRUE)
+        if (!inherits(tz0, "try-error") && length(tz0) == 1L) {
+            tz <- trimws(tz0)
+            if (nzchar(tz)) {
+                cacheIt(tz)
+                return(tz)
+            }
+        }
+    }
+
